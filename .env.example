# Vite envs must start with VITE_

# ============================================
# REQUIRED: Supabase Configuration
# ============================================
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
# Use the ANON (public) key, NOT the service_role key!
VITE_SUPABASE_URL=https://rtsdqkhosqeptvxpatay.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# Optional: Multi-Storage Setup
# ============================================
# If using multiple Supabase projects for storage
# VITE_SUPABASE_URL_1=https://project-1.supabase.co
# VITE_SUPABASE_ANON_KEY_1=your-anon-key-1

# ============================================
# Optional: Features
# ============================================
# Enable third-party ads only in production
VITE_ENABLE_ADS=false

# AI Utility Server base URL (e.g., http://localhost:8080 or http://EC2_PUBLIC_IP:8080)
VITE_AI_SERVER_URL=http://3.26.129.141:8080

# NM GUARD BETA - AI Captioner Rate Limiting Service
# This service manages access control for AI Captioner feature
# When deployed on Render, use your Render service URL
# Example: https://nm-guard-beta.onrender.com
VITE_NM_GUARD_URL=http://localhost:3001
